// skyforge-mask

функция замаскировать_карту(карта) {
    пусть цифры = ""
    для с в строка_символы(карта) {
        если цифра(с) { цифры = цифры + с }
    }
    если длина(цифры) < 4 { вернуть карта }
    вернуть "**** **** **** " + подстрока(цифры, длина(цифры) - 4, длина(цифры))
}

функция замаскировать_кастомно(текст, в_начале, в_конце) {
    если длина(текст) <= в_начале + в_конце {
        вернуть повтор("*", длина(текст))
    }
    пусть скрыто = длина(текст) - в_начале - в_конце
    вернуть подстрока(текст, 0, в_начале) + повтор("*", скрыто) + подстрока(текст, длина(текст) - в_конце, длина(текст))
}
